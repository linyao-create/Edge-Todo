{
  "manifest_version": 3,
  "name": "Edge Todo：存当前页到随记",
  "version": "1.0.1",
  "description": "单击工具栏图标，将当前网页标题和链接保存到 Mac 上的 Edge Todo 随记。",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "存入随记",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
